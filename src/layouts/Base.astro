---
import { site, links } from '../data/site';
interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#12233f"/><path d="M16 5c1 5 7 7 7 13a7 7 0 0 1-14 0c0-3 2-4 3-7 1 2 1 3 2 4 1-3 1-6 2-10z" fill="#f2793a"/></svg>
          <span>cancermodel<b>.eu</b></span>
        </a>
        <nav aria-label="Main">
          <a href="/#model">The model</a>
          <a href="/#get-involved">Get involved</a>
          <a href="/blog/">Blog</a>
          <a class="btn small" href={links.guide}>Open the guide</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p>
          <strong>{site.title}</strong><br />
          A Phoenix Initiative project, developed with <a href={links.hl7Europe}>HL7 Europe</a>.
        </p>
        <ul>
          <li><a href={links.guide}>Implementation guide</a></li>
          <li><a href={links.repo}>Source on GitHub</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbf8f4;
    --surface: #ffffff;
    --ink: #12233f;
    --muted: #55617a;
    --line: #e4ddd3;
    --accent: #d9541a;
    --accent-ink: #ffffff;
    --navy: #12233f;
    --navy-ink: #f4efe8;
    --navy-muted: #b6c0d4;
    --ember: #f2793a;
    --gold: #f6b84b;
    --radius: 14px;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c1626;
      --surface: #14213a;
      --ink: #f1ece4;
      --muted: #a9b4c9;
      --line: #263553;
      --accent: #f2793a;
      --accent-ink: #1a0e05;
      --navy: #08101d;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 5rem; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 1.0625rem/1.65 var(--font); -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { font-family: var(--serif); line-height: 1.15; margin: 0 0 .6em; letter-spacing: -.01em; text-wrap: balance; }
  h1 { font-size: clamp(2.3rem, 6vw, 4.2rem); }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); }
  h3 { font-size: 1.3rem; }
  p { margin: 0 0 1em; }
  a { color: var(--accent); text-underline-offset: .18em; }
  a:focus-visible, .btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 4px; }
  .wrap { width: min(1120px, 100% - 2rem); margin-inline: auto; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: .5rem 1rem; z-index: 10; }
  .eyebrow { font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: .8rem; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 46rem; }
  section { padding: clamp(3rem, 8vw, 5.5rem) 0; }

  .btn {
    display: inline-flex; align-items: center; gap: .5rem; padding: .8rem 1.3rem; border-radius: 999px;
    background: var(--accent); color: var(--accent-ink); font-weight: 650; text-decoration: none;
    border: 2px solid var(--accent); transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -8px var(--accent); }
  .btn.ghost { background: transparent; color: inherit; border-color: currentColor; }
  .btn.small { padding: .45rem .95rem; font-size: .92rem; }

  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; flex-wrap: wrap; padding-block: .5rem; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--ink); text-decoration: none; font-weight: 650; }
  .brand b { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
  nav a:not(.btn) { color: var(--ink); text-decoration: none; font-size: .95rem; }
  nav a:not(.btn):hover { color: var(--accent); }

  .site-footer { background: var(--navy); color: var(--navy-muted); padding: 2.5rem 0; font-size: .95rem; }
  .site-footer strong { color: var(--navy-ink); }
  .site-footer a { color: var(--gold); }
  .foot { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.4rem; flex-wrap: wrap; }

  .post-list { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .post-card { display: block; height: 100%; padding: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; transition: border-color .15s, transform .15s; }
  .post-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .post-card time { font-size: .85rem; color: var(--muted); }
  .post-card h3 { margin: .3rem 0 .4rem; }
  .post-card p { color: var(--muted); margin: 0; font-size: .98rem; }
</style>
