---
import { site, links } from '../data/site';
interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <img src="/brand/phoenix-emblem.svg" alt="" width="27" height="40" />
          <span>cancermodel<b>.eu</b></span>
        </a>
        <nav aria-label="Main">
          <a href="/#why">Why now</a>
          <a href="/#model">The model</a>
          <a href="/#ehds">EHDS</a>
          <a href="/#get-involved">Get involved</a>
          <a href="/#phoenix">PHOENIX</a>
          <a href="/blog/">Blog</a>
        </nav>
        <a class="btn small guide-btn" href={links.guide}>Implementation guide</a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <img src="/brand/phoenix-logo-white-tight.svg" alt="PHOENIX, Patient Health Oncological Expertise Network for International eXchange, an HL7 Europe initiative" width="169" height="84" />
          <p>
            <strong>{site.title}</strong><br />
            Developed by PHOENIX, an HL7 Europe initiative.{' '}
            <a href={links.hl7Europe}>hl7europe.org</a>
          </p>
        </div>
        <ul>
          <li><a href={links.guide}>Implementation guide</a></li>
          <li><a href={links.repo}>Source on GitHub</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href={links.contact}>phoenix@hl7europe.org</a></li>
        </ul>
        <p class="legal">® Health Level Seven and HL7 are registered trademarks of Health Level Seven International, registered with the United States Patent and Trademark Office.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --surface: #ffffff;
    --tint: #f3f6fc;
    --ink: #14213f;
    --muted: #4f5b76;
    --line: #dbe2f0;
    --blue: #1a3c8a;
    --blue-ink: #ffffff;
    --blue-muted: #c9d5f2;
    --accent: #1a3c8a;
    --accent-ink: #ffffff;
    --flame: #e46b23;
    --flame-ink: #c4470f; /* flame for text on light backgrounds: 4.9:1 on white */
    --gold: #fcd800;
    --radius: 14px;
    --font: Aptos, 'Segoe UI', system-ui, -apple-system, Roboto, 'Helvetica Neue', Arial, sans-serif;
    --flame-gradient: linear-gradient(90deg, #fcd800, #f0a11e 35%, #e46b23 60%, #db2027);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 5.5rem; }
  @media (max-width: 760px) { html { scroll-padding-top: 1rem; } }
  ::selection { background: var(--gold); color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 1.0625rem/1.65 var(--font); -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { font-family: var(--font); font-weight: 700; color: var(--blue); line-height: 1.15; margin: 0 0 .6em; letter-spacing: -.015em; text-wrap: balance; }
  h1 { font-size: clamp(2.3rem, 6vw, 4.2rem); }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.5rem); }
  h3 { font-size: 1.3rem; }
  p { margin: 0 0 1em; text-wrap: pretty; }
  dd, li, figcaption { text-wrap: pretty; }
  a { color: var(--accent); text-underline-offset: .18em; }
  a:focus-visible, .btn:focus-visible { outline: 3px solid var(--flame); outline-offset: 3px; border-radius: 4px; }
  .wrap { width: min(1120px, 100% - 2rem); margin-inline: auto; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; background: var(--surface); padding: .5rem 1rem; z-index: 10; }
  .lede { font-size: 1.2rem; color: var(--muted); max-width: 46rem; }
  section { padding: clamp(3rem, 8vw, 5.5rem) 0; }

  .btn {
    display: inline-flex; align-items: center; gap: .5rem; padding: .8rem 1.3rem; border-radius: 999px;
    background: var(--accent); color: var(--accent-ink); font-weight: 650; text-decoration: none;
    border: 2px solid var(--accent); transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -8px var(--accent); }
  .btn.small { padding: .45rem .95rem; font-size: .92rem; }

  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 1rem 1.5rem; min-height: 4rem; padding-block: .5rem; }
  .bar nav { margin-left: auto; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; color: var(--blue); text-decoration: none; font-weight: 650; }
  .brand b { color: var(--flame-ink); }
  .brand img { height: 40px; width: auto; }
  nav { display: flex; align-items: center; gap: 1.2rem; }
  nav a { color: var(--ink); text-decoration: none; font-size: .95rem; white-space: nowrap; }
  nav a:hover { color: var(--accent); text-decoration: underline; }
  .guide-btn { white-space: nowrap; }
  @media (max-width: 960px) {
    .site-header { position: static; overflow-x: clip; }
    .bar { display: grid; grid-template-columns: 1fr auto; gap: .25rem 1rem; padding-block: .6rem 0; }
    .bar nav { grid-column: 1 / -1; grid-row: 2; margin: 0 -1rem; padding: .35rem 1rem .5rem; overflow-x: auto; scrollbar-width: none; gap: 1.4rem; }
    .bar nav::-webkit-scrollbar { display: none; }
    nav a { padding-block: .45rem; }
  }
  @media (max-width: 400px) { .brand span { font-size: .95rem; } .guide-btn { font-size: .85rem; padding: .45rem .8rem; } }

  .site-footer { background: var(--blue); color: var(--blue-muted); padding: 2.5rem 0; font-size: .95rem; }
  .site-footer strong { color: var(--blue-ink); }
  .site-footer a { color: var(--blue-ink); }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .foot-brand { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .foot-brand img { height: 84px; width: auto; }
  .foot-brand p { margin: 0; max-width: 26rem; }
  .foot ul { list-style: none; margin: 0; padding: 0; display: flex; gap: .4rem 1.4rem; flex-wrap: wrap; }
  .foot ul a { display: inline-block; padding-block: .2rem; }
  .legal { flex-basis: 100%; margin: 0; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.18); font-size: .8rem; }

  .post-list { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .post-card { display: block; height: 100%; padding: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; transition: border-color .15s, box-shadow .15s; }
  .post-card:hover { border-color: var(--blue); box-shadow: 0 14px 28px -22px var(--blue); }
  .post-card time { font-size: .85rem; color: var(--muted); }
  .post-card h2, .post-card h3 { margin: .3rem 0 .4rem; font-size: 1.15rem; }
  .page-title { font-size: clamp(2rem, 5vw, 3.2rem); }
  .post-card p { color: var(--muted); margin: 0; font-size: .98rem; }
</style>
