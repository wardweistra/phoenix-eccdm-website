---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Blog" description="News, release notes and implementation stories about the European Common Cancer Data Model.">
  <section>
    <div class="wrap">
      <p class="eyebrow">Blog</p>
      <h1 style="font-size:clamp(2rem,5vw,3.2rem)">Updates from the PHOENIX</h1>
      <p class="lede">Release notes, implementation stories and meeting summaries.</p>
      {posts.length === 0 ? <p>No posts yet.</p> : (
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
