---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { links, actions, guideLabel, guideNote } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Findings of the HL7 Europe cancer working group's survey of European cancer projects (Athens, 2024).
const findings = [
  { k: 'Heterogeneity', v: 'Projects describe the same cancer concepts in different models and datasets, so little is reused.' },
  { k: 'Hard to map', v: 'Moving between FHIR and OMOP relies on ad hoc mappings, rebuilt by every project.' },
  { k: 'Research first', v: 'Most models serve secondary use, so the cancer journey has to be reconstructed after the fact.' },
  { k: 'EHR availability', v: 'Which of these data hospital records can actually supply is still unknown.' },
];
const reasons = [
  { title: 'Patients travel, and so must their data', text: 'Care crosses hospitals, regions and borders. That only works if everyone agrees how to exchange information and how to interpret it.' },
  { title: 'A research foundation to build on', text: 'IDEA4RC, PanCareSurPass and FLUTE started a common data model for (rare) cancer research and showed how much international collaboration it takes.' },
  { title: 'A policy window', text: 'The European Health Data Space now requires cross-border exchange and reuse of health data.', href: '#ehds', more: 'How the ECCDM fits' },
];
const layers = [
  { k: 'Conceptual model', v: 'Shared semantics: what we mean' },
  { k: 'Logical model', v: 'Structure along the cancer history' },
  { k: 'Implementation guide', v: 'FHIR profiles and OMOP mappings' },
];
const standards = [
  { name: 'HL7 FHIR', role: 'Exchange of patient-level data between EHRs; the basis of the EHDS exchange format.', rel: 'A representation of the ECCDM. FHIR profiling is the next step in the implementation guide.' },
  { name: 'OMOP', org: 'OHDSI', role: 'Analytics and secondary use: cohorts, network studies and real-world evidence.', rel: 'A representation of the ECCDM, aligned with the OHDSI Oncology working group.' },
  { name: 'mCODE', org: 'CodeX', role: 'Minimal common oncology data elements on FHIR, developed in the United States.', rel: 'Aligned. The ECCDM is developed in collaboration with mCODE/CodeX.' },
];
const principles = [
  { k: 'Scope', v: 'Non-exhaustive and cancer-type agnostic' },
  { k: 'Use', v: 'Primary and secondary use aligned' },
  { k: 'Feasibility', v: 'EHR-aware and realistic' },
  { k: 'Development', v: 'Incremental and community-driven' },
];
// Update the date together with the states.
const statusDate = { iso: '2026-11', label: 'November 2026' };
const status = [
  { state: 'done', label: 'Conceptual model', note: 'Version 1, agreed by the working group' },
  { state: 'done', label: 'Logical model', note: 'Version 1, agreed by the working group' },
  { state: 'doing', label: 'Implementation guide', note: 'Ballot closed, comment reconciliation pending' },
  { state: 'doing', label: 'OMOP mapping', note: 'Started' },
  { state: 'next', label: 'FHIR profiling and mapping', note: 'Pending' },
];
const stateText: Record<string, string> = { done: 'Done', doing: 'In progress', next: 'Next' };
const useCases = ['data exchange for direct patient care', 'computable guidelines', 'cancer registry reporting', 'EHR endpoints for clinical trials', 'trial matching'];
const founders = [
  { group: 'Standards', names: ['HL7 Europe'] },
  { group: 'National cancer organisations', names: ['Institut National du Cancer (INCa)', 'Netherlands Comprehensive Cancer Organisation (IKNL)'] },
  { group: 'Hospitals and cancer centres', names: ['Assistance Publique – Hôpitaux de Paris (AP-HP)', 'Centre Antoine Lacassagne (CAL)', 'Charité Berlin', 'Charleroi Hospital'] },
  { group: 'Research and innovation', names: ['Berlin Institute of Health at Charité (BIH)', 'Paris-Saclay Cancer Cluster (PSCC)'] },
  { group: 'Industry', names: ['InterSystems Belgium'] },
];
---
<Base>
  <section class="hero">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="blob b3" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>One shared model for cancer data across Europe.</h1>
        <p class="hero-lede">
          The European Common Cancer Data Model (ECCDM) gives hospitals, registries and
          researchers one way to describe a patient's cancer history. Meaning is defined once,
          then represented in HL7 FHIR for care and OMOP for research.
        </p>
        <div class="hero-cta">
          <a class="btn light" href={links.guide}>{guideLabel}</a>
          <a class="text-link" href="#get-involved">Four ways to get involved</a>
        </div>
        <p class="cta-note">{guideNote}</p>
      </div>

      <figure class="hub">
        <div class="hub-diagram" aria-hidden="true">
          <ul class="hub-src"><li>Hospital records</li><li>Cancer registries</li><li>Research projects</li></ul>
          <svg class="hub-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0 16.7 C55 16.7 45 50 100 50 M0 50 H100 M0 83.3 C55 83.3 45 50 100 50" />
          </svg>
          <div class="hub-core"><b>ECCDM</b><span>defined once</span></div>
          <svg class="hub-lines out" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs><linearGradient id="flame" x1="0" x2="1"><stop offset="0" stop-color="#fcd800"/><stop offset=".55" stop-color="#e46b23"/><stop offset="1" stop-color="#db2027"/></linearGradient></defs>
            <path d="M0 50 C55 50 45 25 100 25 M0 50 C55 50 45 75 100 75" />
          </svg>
          <ul class="hub-rep"><li><b>HL7 FHIR</b><span>exchange for care</span></li><li><b>OMOP</b><span>research and reuse</span></li></ul>
        </div>
        <figcaption>
          Cancer data from hospital records, registries and research projects is described once in
          the ECCDM, then represented in HL7 FHIR for care and in OMOP for research.
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="why">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>Europe's cancer projects share concepts, not models.</h2>
          <p class="lede">
            In 2024 the HL7 Europe cancer working group surveyed European cancer projects. Each
            had built its own model for the same cancer history.
          </p>
        </div>
        <dl class="findings">
          {findings.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>

      <h3 class="minor">Why now</h3>
      <ul class="reasons">
        {reasons.map((r) => (
          <li>
            <h4>{r.title}</h4>
            <p>{r.text}{r.href && <> <a href={r.href}>{r.more}</a></>}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="model" class="tinted">
    <div class="blob b4" aria-hidden="true"></div>
    <div class="wrap">
      <h2>Builds on FHIR, OMOP and mCODE. Does not compete with them.</h2>
      <p class="lede">
        The ECCDM is a model rather than a format: a minimal, extensible backbone for cancer
        history, independent of any one standard and represented in the standards Europe
        already uses.
      </p>

      <ol class="layers" aria-label="Parts of the ECCDM">
        {layers.map((l) => <li><b>{l.k}</b><span>{l.v}</span></li>)}
      </ol>

      <div class="compare">
        <figure>
          <figcaption><b>Today</b> Every project builds its own FHIR↔OMOP mapping.</figcaption>
          <ul class="maps today" aria-hidden="true">
            <li><span>FHIR</span><i></i><span>OMOP</span></li>
            <li><span>FHIR</span><i></i><span>OMOP</span></li>
            <li><span>FHIR</span><i></i><span>OMOP</span></li>
          </ul>
        </figure>
        <figure>
          <figcaption><b>With the ECCDM</b> Meaning is defined once and mapped once, and every project reuses it.</figcaption>
          <div class="maps once" aria-hidden="true">
            <span>FHIR</span><i></i><strong>ECCDM</strong><i></i><span>OMOP</span>
          </div>
        </figure>
      </div>

      <div class="table-wrap">
        <table class="standards">
          <caption>How the ECCDM relates to the standards you use</caption>
          <thead><tr><th scope="col">Standard</th><th scope="col">What it is for</th><th scope="col">Relation to the ECCDM</th></tr></thead>
          <tbody>
            {standards.map((s) => (
              <tr>
                <th scope="row">{s.name}{s.org && <small>{s.org}</small>}</th>
                <td>{s.role}</td>
                <td>{s.rel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-note">
        Reuse where possible, align where needed, create only where necessary.
      </p>
    </div>
  </section>

  <section id="ehds">
    <div class="wrap">
      <h2>The oncology layer for the European Health Data Space</h2>
      <p class="lede">
        The EHDS Regulation (EU) 2025/327 has applied since March 2025, in phases up to 2031.
        It builds on HL7 Europe's FHIR specifications. The ECCDM adds what those general
        specifications leave out for cancer.
      </p>
      <div class="ehds">
        <div class="ehds-col">
          <h3>Primary use <small>MyHealth@EU · European EHR exchange format</small></h3>
          <div class="layer adds">
            <span>ECCDM adds</span>
            <p>An oncology layer on the European base profiles: tumour, staging, treatments and outcomes.</p>
          </div>
          <div class="layer base">
            <span>EHDS provides</span>
            <p>HL7 Europe FHIR specifications: patient summary, laboratory, imaging and discharge report.</p>
          </div>
        </div>
        <div class="ehds-col">
          <h3>Secondary use <small>HealthData@EU · Health Data Access Bodies</small></h3>
          <div class="layer adds">
            <span>ECCDM adds</span>
            <p>Cancer data that is documented, comparable and ready to map to OMOP.</p>
          </div>
          <div class="layer base">
            <span>EHDS provides</span>
            <p>Data holders make data available for research, with documented quality.</p>
          </div>
        </div>
      </div>
      <p class="table-note">FHIR profiling for this layer is the next step. <a href="#status">See where the work stands</a>.</p>
    </div>
  </section>

  <section id="status" class="tinted">
    <div class="wrap">
      <h2>Version 1 is a milestone, not the destination.</h2>
      <p class="asof">Status as of <time datetime={statusDate.iso}>{statusDate.label}</time></p>
      <ol class="track">
        {status.map((s) => (
          <li class={s.state}>
            <span class={`pill ${s.state}`}>{stateText[s.state]}</span>
            <b>{s.label}</b>
            <span class="note">{s.note}</span>
          </li>
        ))}
      </ol>
      <p class="then">
        <b>Then:</b> testing on real data in reference implementations and connectathons, and
        pilots in cancer centres. Real implementations decide how the model grows, including
        genomics and other new domains.
      </p>
      <div class="status-foot">
        <dl class="principles">
          {principles.map((p) => <div><dt>{p.k}</dt><dd>{p.v}</dd></div>)}
        </dl>
        <ul class="dev-links">
          <li><a href={links.guide}>Published implementation guide</a></li>
          <li><a href={links.guideDraft}>Working draft (continuous build)</a></li>
          <li><a href={links.repo}>Source and issues on GitHub</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="get-involved">
    <div class="wrap">
      <h2>Start with the model. Go as far as you like from there.</h2>
      <ol class="steps">
        {actions.map((a) => (
          <li>
            <span class="step-n" aria-hidden="true">{a.step}</span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <a class="step-link" href={a.href}>{a.cta} <span aria-hidden="true">→</span></a>
            <span class="via">{a.via}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="phoenix" class="tinted">
    <div class="wrap">
      <h2>Who is behind it</h2>
      <div class="split">
        <div>
          <p class="lede">
            The ECCDM was developed by the HL7 Europe cancer working group. PHOENIX, the Patient
            Health Oncological Expertise Network for International eXchange, now carries it
            forward with shared capacity instead of project-by-project effort.
          </p>
          <dl class="facts">
            <div><dt>Form</dt><dd>An HL7 Europe accelerator: open, consensus-based, publishing public artefacts.</dd></div>
            <div><dt>Model</dt><dd>HL7 accelerators such as CodeX, Vulcan and Helios have shown that consortia speed up standards adoption.</dd></div>
            <div><dt>Launched</dt><dd>At Hospitals on FHIR, Pisa, 21 October 2026.</dd></div>
            <div><dt>Builds on</dt><dd>The IDEA4RC, PanCareSurPass and FLUTE projects.</dd></div>
          </dl>
          <p class="context">
            The model should enable {useCases.slice(0, -1).join(', ')} and {useCases.at(-1)}.
            The need is growing: 21 million new cancer cases and 10 million deaths worldwide in
            2024, with 34 million new cases a year projected by 2050.
          </p>
        </div>
        <div>
          <h3>Founding members</h3>
          <dl class="founders">
            {founders.map((g) => (
              <div>
                <dt>{g.group}</dt>
                <dd><ul>{g.names.map((n) => <li>{n}</li>)}</ul></dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 1 && (
    <section id="news">
      <div class="wrap">
        <h2>Latest updates</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
        <p class="more"><a href="/blog/">All posts →</a></p>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="wrap">
      <p class="quote">The only way forward is together.</p>
      <p class="quote-sub">Help us shape the oncology standards of the future.</p>
      <div class="hero-cta center">
        <a class="btn light" href={links.guide}>{guideLabel}</a>
        <a class="btn outline" href={links.membership}>Ask about joining PHOENIX</a>
      </div>
    </div>
  </section>
</Base>

<style>
  section { position: relative; overflow: hidden; }
  .wrap { position: relative; }
  .tinted { background: var(--tint); border-block: 1px solid var(--line); }
  .split { display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); align-items: start; }
  .minor { font-size: 1rem; letter-spacing: 0; margin: clamp(3rem, 6vw, 4.5rem) 0 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }

  /* Soft blurred shapes, echoing the PHOENIX slide template */
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; }
  .hero .b1, .closing .b1 { width: 34rem; height: 22rem; left: -14rem; bottom: -14rem; background: #dfe7f7; opacity: .45; }
  .hero .b2, .closing .b2 { width: 26rem; height: 14rem; right: 18%; top: -9rem; background: #7fb0f0; opacity: .6; }
  .hero .b3 { width: 22rem; height: 16rem; right: -8rem; bottom: -9rem; background: #e9a48a; opacity: .4; }
  .b4 { width: 30rem; height: 16rem; right: -8rem; top: -9rem; background: #e8a25c; opacity: .3; }

  /* Hero */
  .hero, .closing { background: var(--blue); color: var(--blue-ink); }
  .hero { padding: clamp(3rem, 9vw, 6.5rem) 0; }
  .hero-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; }
  .hero h1 { color: #fff; max-width: 13ch; }
  .hero-lede { font-size: 1.2rem; color: var(--blue-muted); max-width: 36rem; }
  .hero-cta { display: flex; align-items: center; gap: .75rem 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero-cta.center { justify-content: center; }
  .btn.light { background: #fff; border-color: #fff; color: var(--blue); }
  .btn.outline { background: transparent; border-color: rgba(255,255,255,.6); color: #fff; }
  .text-link { color: #fff; font-weight: 650; text-underline-offset: .25em; }
  .text-link:hover { text-decoration-thickness: 2px; }
  .cta-note { margin: .9rem 0 0; font-size: .9rem; color: var(--blue-muted); }

  .hub { margin: 0; }
  .hub-diagram { display: grid; grid-template-columns: minmax(0, 1fr) 2.75rem auto 2.75rem minmax(0, 1fr); align-items: stretch; }
  .hub ul { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-rows: 1fr; gap: .6rem; }
  .hub-src li { display: flex; align-items: center; padding: .55rem .8rem; border-radius: 10px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.22); font-size: .92rem; line-height: 1.25; }
  .hub-lines { width: 100%; height: 100%; overflow: visible; }
  .hub-lines path { fill: none; stroke: rgba(255,255,255,.45); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .hub-lines.out path { stroke: url(#flame); stroke-width: 3; }
  .hub-core { align-self: center; display: grid; justify-items: center; padding: 1.1rem 1rem; border-radius: var(--radius); background: #fff; color: var(--blue); box-shadow: 0 18px 40px -18px rgba(5, 15, 45, .7); }
  .hub-core b { font-size: 1.35rem; letter-spacing: .02em; }
  .hub-core span { font-size: .8rem; color: var(--muted); white-space: nowrap; }
  .hub-rep { gap: 1.2rem !important; }
  .hub-rep li { display: grid; align-content: center; padding: .7rem .9rem; border-radius: 10px; border: 2px solid #fff; line-height: 1.25; }
  .hub-rep b { font-size: 1.05rem; }
  .hub-rep span { font-size: .85rem; color: var(--blue-muted); }
  .hub figcaption { margin-top: 1.1rem; font-size: .9rem; color: var(--blue-muted); max-width: 30rem; }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .hub-diagram { grid-template-columns: 1fr; gap: 0; }
    .hub-src { grid-template-columns: repeat(3, 1fr); grid-auto-rows: auto !important; }
    .hub-src li { justify-content: center; text-align: center; font-size: .82rem; padding: .5rem .4rem; }
    .hub-lines { display: none; }
    .hub-core { justify-self: center; margin-block: 1.4rem; position: relative; }
    .hub-core::before, .hub-core::after { content: ''; position: absolute; left: 50%; width: 2px; height: 1.4rem; transform: translateX(-50%); }
    .hub-core::before { bottom: 100%; background: rgba(255,255,255,.45); }
    .hub-core::after { top: 100%; width: 3px; background: linear-gradient(#e46b23, #db2027); }
    .hub-rep { grid-template-columns: 1fr 1fr; grid-auto-rows: auto !important; gap: .6rem !important; }
  }

  /* Problem */
  .findings { margin: 0; border-top: 1px solid var(--line); }
  .findings div { display: grid; grid-template-columns: minmax(8rem, 10rem) 1fr; gap: .4rem 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .findings dt { font-weight: 700; color: var(--blue); }
  .findings dd { margin: 0; color: var(--muted); }
  @media (max-width: 520px) { .findings div { grid-template-columns: 1fr; } }
  .reasons { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .reasons h4 { margin: 0 0 .4rem; font-size: 1.05rem; color: var(--ink); line-height: 1.3; }
  .reasons p { color: var(--muted); margin: 0; font-size: .98rem; }

  /* Model */
  .layers { list-style: none; padding: 0; margin: 2.5rem 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; background: var(--blue); padding: .5rem; border-radius: var(--radius); counter-reset: layer; }
  .layers li { display: grid; gap: .15rem; padding: 1rem 1.2rem; border-radius: 10px; background: rgba(255,255,255,.1); color: #fff; position: relative; }
  .layers li + li::before { content: ''; position: absolute; left: -.5rem; top: 50%; width: .5rem; height: 3px; background: var(--flame-gradient); }
  .layers b { font-size: 1.1rem; }
  .layers span { color: var(--blue-muted); font-size: .93rem; }
  @media (max-width: 680px) {
    .layers { grid-template-columns: 1fr; }
    .layers li + li::before { left: 1.2rem; top: -.5rem; width: 3px; height: .5rem; }
  }

  .compare { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); margin-bottom: 2.5rem; }
  .compare figure { margin: 0; padding: 1.4rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: 1.2rem; align-content: start; }
  .compare figcaption { color: var(--muted); }
  .compare figcaption b { display: block; color: var(--ink); font-size: 1.05rem; }
  .maps { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; font-size: .85rem; font-weight: 700; }
  .maps span, .maps strong { padding: .25rem .6rem; border-radius: 6px; border: 1.5px solid var(--blue); color: var(--blue); text-align: center; }
  .maps i { display: block; height: 0; border-top: 2px dashed var(--muted); align-self: center; }
  .today li { display: grid; grid-template-columns: auto 1fr auto; gap: .5rem; align-items: center; }
  .today li:nth-child(2) i { border-top-style: dotted; border-color: #9a3d0b; }
  .today li:nth-child(3) i { border-top-width: 3px; border-style: double; }
  .once { grid-template-columns: auto 1fr auto 1fr auto; align-items: center; align-self: center; }
  .once i { border-top: 3px solid transparent; border-image: var(--flame-gradient) 1; }
  .once strong { background: var(--blue); color: #fff; padding: .55rem .9rem; font-size: 1rem; }

  .table-wrap { overflow-x: auto; }
  .standards { width: 100%; border-collapse: collapse; font-size: .97rem; }
  .standards caption { text-align: left; font-weight: 700; color: var(--blue); font-size: 1.2rem; margin-bottom: .8rem; }
  .standards th, .standards td { text-align: left; vertical-align: top; padding: .9rem 1rem .9rem 0; border-bottom: 1px solid var(--line); }
  .standards thead th { font-size: .85rem; color: var(--muted); font-weight: 650; border-bottom-color: var(--blue); }
  .standards tbody th { color: var(--blue); white-space: nowrap; }
  .standards small { display: block; font-weight: 400; color: var(--muted); }
  .standards td { color: var(--muted); }
  .standards td:last-child { color: var(--ink); }
  @media (max-width: 680px) {
    .standards thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .standards tr, .standards th, .standards td { display: block; padding-right: 0; }
    .standards tbody tr { border-bottom: 1px solid var(--line); padding-block: .6rem; }
    .standards th, .standards td { border: 0; padding-block: .2rem; }
    .standards tbody th small { display: inline; margin-left: .4rem; }
