---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { links, actions } from '../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const stats = [
  { n: '21 million', label: 'new cancer cases worldwide in 2024' },
  { n: '10 million', label: 'deaths worldwide in 2024' },
  { n: '34 million', label: 'new cases a year projected for 2050' },
];
const reasons = [
  { title: 'Patients travel, and so must their data', text: 'Care crosses hospitals, regions and borders. Sharing within direct patient care only works if everyone agrees how to exchange information and how to interpret it.' },
  { title: 'A research foundation to build on', text: 'IDEA4RC, PanCareSurPass and FLUTE started a common data model for (rare) cancer research, and showed how much international collaboration is needed.' },
  { title: 'A policy window', text: 'The European Health Data Space promotes cross-border exchange and reuse of health data, and sets requirements such as the European EHR exchange format.' },
];
const principles = [
  { k: 'Scope', v: 'Non-exhaustive and cancer-type agnostic' },
  { k: 'Use', v: 'Primary and secondary use aligned' },
  { k: 'Feasibility', v: 'EHR-aware and realistic' },
  { k: 'Development', v: 'Incremental and community-driven' },
];
const status = [
  { state: 'done', label: 'Conceptual model', note: 'Completed, agreed by the working group' },
  { state: 'done', label: 'Logical model', note: 'Completed, agreed by the working group' },
  { state: 'doing', label: 'Implementation guide', note: 'Ballot closed, comment reconciliation pending' },
  { state: 'doing', label: 'OMOP mapping', note: 'Started' },
  { state: 'next', label: 'FHIR profiling and mapping', note: 'Pending' },
];
const stateText: Record<string, string> = { done: 'Done', doing: 'In progress', next: 'Next' };
const useCases = ['Data exchange for direct patient care', 'Computable guidelines', 'Cancer registry reporting', 'EHR endpoints for clinical trials', 'Trial matching'];
const founders = [
  'HL7 Europe',
  'Institut National du Cancer (INCa)',
  'Netherlands Comprehensive Cancer Organisation (IKNL)',
  'Paris-Saclay Cancer Cluster (PSCC)',
  'Berlin Institute of Health at Charité (BIH)',
  'Centre Antoine Lacassagne (CAL)',
  'InterSystems Belgium',
  'Assistance Publique – Hôpitaux de Paris (AP-HP)',
  'Charité Berlin',
  'Charleroi Hospital',
];
---
<Base>
  <section class="hero">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="blob b3" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <p class="hero-eyebrow">European Common Cancer Data Model</p>
        <h1>One shared model for cancer data across Europe.</h1>
        <p class="hero-lede">
          The ECCDM gives hospitals, registries and researchers one way to describe a patient's
          cancer history, so data can be exchanged for care and reused for research without
          being remodelled each time.
        </p>
        <div class="hero-cta">
          <a class="btn light" href={links.guide}>Use the ECCDM</a>
          <a class="btn outline" href="#get-involved">Four ways to get involved</a>
        </div>
      </div>
      <img class="hero-logo" src="/brand/phoenix-logo-white-tight.svg" width="338" height="168"
        alt="PHOENIX, Patient Health Oncological Expertise Network for International eXchange, an HL7 Europe initiative" />
    </div>
  </section>

  <section id="why">
    <div class="wrap">
      <p class="eyebrow">Why now</p>
      <h2>Reducing the impact of cancer takes more than data. It takes interoperable data.</h2>
      <ul class="stats">
        {stats.map((s) => <li><b>{s.n}</b><span>{s.label}</span></li>)}
      </ul>
      <ul class="reasons">
        {reasons.map((r) => <li><h3>{r.title}</h3><p>{r.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section id="model" class="tinted">
    <div class="blob b4" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">The model</p>
      <h2>One backbone, multiple representations</h2>
      <p class="lede">
        Europe's cancer projects share the same concepts but model them differently, so every
        link between FHIR and OMOP ends up as an ad hoc mapping. The ECCDM is a model rather
        than a dataset: a minimal, extensible backbone for cancer history that stays
        independent of any one standard.
      </p>

      <div class="backbone" role="img" aria-label="The conceptual and logical models form a standard-agnostic backbone, which is represented in both HL7 FHIR and OMOP.">
        <div class="core">
          <span>Standard-agnostic backbone</span>
          <div><b>Conceptual model</b><i>Shared semantics</i></div>
          <div><b>Logical model</b><i>Implementation structure</i></div>
        </div>
        <div class="arrow" aria-hidden="true"></div>
        <div class="reps">
          <div><b>HL7 FHIR</b><i>Exchange in care</i></div>
          <div><b>OMOP</b><i>Research and secondary use</i></div>
        </div>
      </div>

      <div class="two">
        <div>
          <h3>Principles</h3>
          <dl class="principles">
            {principles.map((p) => <div><dt>{p.k}</dt><dd>{p.v}</dd></div>)}
          </dl>
        </div>
        <div>
          <h3>Where it stands</h3>
          <ul class="status">
            {status.map((s) => (
              <li>
                <span class={`pill ${s.state}`}>{stateText[s.state]}</span>
                <span><b>{s.label}</b><br />{s.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="aside">
        Developed in the open by the HL7 Europe cancer working group, in collaboration with the
        OHDSI Oncology working group and mCODE/CodeX.{' '}
        <a href={links.guide}>Read the implementation guide →</a>
      </p>
    </div>
  </section>

  <section id="get-involved">
    <div class="wrap">
      <p class="eyebrow">Get involved</p>
      <h2>Four steps, each one optional</h2>
      <p class="lede">Start by using the model. Go as far as you like from there.</p>
      <ol class="steps">
        {actions.map((a) => (
          <li>
            <span class="step-n" aria-hidden="true">{a.step}</span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <a class="step-link" href={a.href}>{a.cta} <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="phoenix" class="tinted">
    <div class="wrap">
      <p class="eyebrow">PHOENIX</p>
      <h2>The cancer community, together, making health data interoperable</h2>
      <p class="lede">
        First for care, then for research and other uses. PHOENIX, the Patient Health
        Oncological Expertise Network for International eXchange, is an HL7 Europe initiative
        that brings care providers, standards developers and implementers together around
        shared oncology requirements.
      </p>
      <div class="two">
        <div>
          <h3>Why an initiative</h3>
          <p>
            Standards take time to develop, and adoption is never quick enough. Hospitals, EHR
            vendors, researchers and insurers each have their own goals: hard to align within
            one country, harder across Europe.
          </p>
          <p>
            HL7 accelerators such as CodeX, Vulcan and Helios have shown that consortia speed
            this up. PHOENIX applies the same idea to European oncology, and moves the ECCDM
            from a project-based effort to shared, lasting capacity.
          </p>
          <h3>What the model should enable</h3>
          <ul class="chips">{useCases.map((u) => <li>{u}</li>)}</ul>
        </div>
        <div>
          <h3>Founding members</h3>
          <ul class="founders">{founders.map((f) => <li>{f}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section id="news">
      <div class="wrap">
        <p class="eyebrow">From the blog</p>
        <h2>Latest updates</h2>
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a class="post-card" href={`/blog/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
        <p style="margin-top:1.5rem"><a href="/blog/">All posts →</a></p>
      </div>
    </section>
  )}

  <section class="closing">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="wrap">
      <p class="quote">The only way forward is together.</p>
      <p class="quote-sub">Help us shape the oncology standards of the future.</p>
      <div class="hero-cta" style="justify-content:center">
        <a class="btn light" href={links.guide}>Use the ECCDM</a>
        <a class="btn outline" href={links.membership}>Join PHOENIX</a>
      </div>
    </div>
  </section>
</Base>

<style>
  section { position: relative; overflow: hidden; }
  .wrap { position: relative; }
  .tinted { background: var(--tint); border-block: 1px solid var(--line); }

  /* Soft blurred shapes, echoing the PHOENIX slide template */
  .blob { position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; }
  .hero .b1, .closing .b1 { width: 34rem; height: 22rem; left: -10rem; bottom: -11rem; background: #dfe7f7; opacity: .55; }
  .hero .b2, .closing .b2 { width: 26rem; height: 14rem; right: 18%; top: -9rem; background: #7fb0f0; opacity: .6; }
  .hero .b3 { width: 22rem; height: 16rem; right: -8rem; bottom: -9rem; background: #e9a48a; opacity: .4; }
  .b4 { width: 30rem; height: 16rem; right: -8rem; top: -9rem; background: #e8a25c; opacity: .35; }

  .hero, .closing { background: var(--blue); color: var(--blue-ink); }
  .hero { padding: clamp(4rem, 10vw, 7.5rem) 0; }
  .hero-grid { display: grid; gap: 3rem; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: center; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .hero-logo { order: -1; max-width: 16rem; } }
  .hero-eyebrow { font-size: .85rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin-bottom: 1rem; }
  .hero h1 { color: #fff; }
  .hero-lede { font-size: 1.25rem; color: var(--blue-muted); max-width: 38rem; }
  .hero-logo { width: 100%; max-width: 24rem; height: auto; justify-self: end; }
  .hero-cta { display: flex; gap: .9rem; flex-wrap: wrap; margin-top: 2rem; }
  .btn.light { background: #fff; border-color: #fff; color: var(--blue); }
  .btn.outline { background: transparent; border-color: rgba(255,255,255,.6); color: #fff; }

  .stats { list-style: none; padding: 0; margin: 2.5rem 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .stats li { padding: 1.5rem; border-radius: var(--radius); background: var(--tint); position: relative; overflow: hidden; }
  .stats li::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--flame-gradient); }
  .stats b { display: block; font-size: clamp(2rem, 4.5vw, 2.9rem); line-height: 1.1; color: var(--blue); font-variant-numeric: tabular-nums; }
  .stats span { color: var(--muted); }
  .reasons { list-style: none; padding: 0; margin: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .reasons h3 { font-size: 1.15rem; }
  .reasons p { color: var(--muted); margin: 0; }

  .backbone { margin: 2.5rem 0; display: grid; grid-template-columns: minmax(0, 1.3fr) 4rem minmax(0, 1fr); align-items: center; }
  .backbone b { display: block; font-size: 1.15rem; }
  .backbone i { font-style: normal; font-size: .93rem; opacity: .85; }
  .core { background: var(--blue); color: #fff; border-radius: var(--radius); padding: 1.4rem; display: grid; gap: .8rem; grid-template-columns: 1fr 1fr; }
  .core > span { grid-column: 1 / -1; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }
  .core > div { padding: 1rem; border-radius: 10px; background: rgba(255,255,255,.12); }
  .arrow { height: 4px; background: var(--flame-gradient); position: relative; margin-inline: .5rem; border-radius: 2px; }
  .arrow::after { content: ''; position: absolute; right: -2px; top: 50%; width: .7rem; height: .7rem; border: solid var(--red); border-width: 4px 4px 0 0; transform: translateY(-50%) rotate(45deg); }
  .reps { display: grid; gap: .8rem; }
  .reps > div { padding: 1rem 1.2rem; border-radius: var(--radius); background: var(--surface); border: 2px solid var(--blue); color: var(--blue); }
  .reps i { color: var(--muted); }
  @media (max-width: 760px) {
    .backbone { grid-template-columns: 1fr; }
    .core { grid-template-columns: 1fr; }
    .arrow { width: 4px; height: 2.5rem; margin: .5rem auto; background: linear-gradient(180deg, #fcd800, #e46b23, #db2027); }
    .arrow::after { right: 50%; top: auto; bottom: -2px; transform: translateX(50%) rotate(135deg); }
  }

  .two { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); margin-top: 2.5rem; }
  .principles { margin: 0; display: grid; gap: .6rem; }
  .principles div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: .8rem 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
  .principles dt { font-weight: 700; color: var(--blue); }
  .principles dd { margin: 0; color: var(--muted); }
  .status { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .status li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; align-items: center; padding: .8rem 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; color: var(--muted); font-size: .95rem; line-height: 1.4; }
  .status b { color: var(--ink); font-size: 1rem; }
  .pill { justify-self: start; padding: .2rem .7rem; border-radius: 999px; font-size: .78rem; font-weight: 700; white-space: nowrap; }
  .pill.done { background: var(--blue); color: #fff; }
  .pill.doing { background: #fde9d9; color: #9a3d0b; }
  .pill.next { background: transparent; color: var(--muted); border: 1px dashed var(--muted); }
  .aside { margin: 2rem 0 0; color: var(--muted); }

  .steps { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .steps li { position: relative; display: flex; flex-direction: column; padding: 1.6rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .15s, border-color .15s, box-shadow .15s; }
  .steps li::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--flame-gradient); transform: scaleX(0); transform-origin: left; transition: transform .25s; }
  .steps li:hover { transform: translateY(-4px); border-color: var(--blue); box-shadow: 0 18px 32px -24px var(--blue); }
  .steps li:hover::before { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) { .steps li, .steps li::before { transition: none; } }
  .step-n { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 10px; background: var(--blue); color: #fff; font-weight: 700; font-size: 1.2rem; margin-bottom: 1rem; }
  .steps h3 { font-size: 1.2rem; }
  .steps p { color: var(--muted); font-size: .98rem; flex: 1; }
  .step-link { font-weight: 700; text-decoration: none; }
  .step-link::after { content: ''; position: absolute; inset: 0; }
  .step-link:hover { text-decoration: underline; }

  .chips { list-style: none; padding: 0; margin: 0; display: flex; gap: .5rem; flex-wrap: wrap; }
  .chips li { padding: .3rem .85rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: .93rem; }
  .founders { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; }
  .founders li { padding: .65rem 1rem; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--blue); border-radius: 8px; font-size: .97rem; }

  .closing { text-align: center; }
  .quote { font-size: clamp(1.9rem, 5vw, 3.2rem); font-weight: 700; line-height: 1.15; margin: 0 0 .5rem; text-wrap: balance; }
  .quote-sub { font-size: 1.25rem; color: var(--blue-muted); margin: 0; }
</style>
